  "schema": 1,
  "updated": "2026-08-04",
  "note": "Known device types. This is data, not code: pairing with a new kind of device means adding an entry here and re-uploading the filesystem image, with no firmware change. The interface reads this file to identify a paired device, to decide which card to draw for it, and to offer the right actions when building an automation.",
  "families": {
    "slwf12": {
      "label": "Air conditioner bridge",
      "capabilities": [
        "climate"
      ],
      "card": "climate",
      "info": "protocol",
      "api": {
        "status": "/api/status",
        "state": "/api/state",
        "command": "/api/state"
      },
      "auth": "bearer",
      "identify": {
        "path": "/api/status",
        "key": "device.type",
        "equals": "slwf12"
      },
      "actions": [
        {
          "id": "power",
          "label": "Power",
          "type": "boolean"
        },
        {
          "id": "mode",
          "label": "Mode",
          "type": "enum",
          "values": [
            "auto",
            "cool",
            "heat",
            "dry",
            "fan_only"
          ]
        },
        {
          "id": "temp",
          "label": "Temperature",
          "type": "number",
          "unit": "°C",
          "min": 16,
          "max": 30,
          "step": 0.5
        },
        {
          "id": "fan",
          "label": "Fan speed",
          "type": "enum",
          "values": [
            "auto",
            "min",
            "low",
            "medium",
            "medium_high",
            "high",
            "max"
          ]
        },
        {
          "id": "swingv",
          "label": "Swing",
          "type": "enum",
          "values": [
            "off",
            "auto",
            "highest",
            "high",
            "middle",
            "low",
            "lowest"
          ]
        },
        {
          "id": "scene",
          "label": "Apply scene",
          "type": "scene"
        }
      ],
      "conditions": [
        {
          "id": "power",
          "label": "Power",
          "type": "boolean"
        },
        {
          "id": "mode",
          "label": "Mode",
          "type": "enum",
          "values": [
            "auto",
            "cool",
