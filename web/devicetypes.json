        {
          "id": "bri",
          "label": "Brightness",
          "type": "number",
          "path": "bri",
          "min": 0,
          "max": 255,
          "step": 5
        },
        {
          "id": "color",
          "label": "Colour",
          "type": "color",
          "path": "seg.0.col.0",
          "writeOnly": true
        },
        {
          "id": "fx",
          "label": "Effect number",
          "type": "number",
          "path": "seg.0.fx",
          "min": 0,
          "max": 200,
          "step": 1,
          "writeOnly": true
        },
        {
          "id": "sx",
          "label": "Effect speed",
          "type": "number",
          "path": "seg.0.sx",
          "min": 0,
          "max": 255,
          "step": 5,
          "writeOnly": true
        },
        {
          "id": "ps",
          "label": "Preset",
          "type": "number",
          "path": "ps",
          "min": 1,
          "max": 250,
          "step": 1
        }
      ],
      "conditions": [
        {
          "id": "on",
          "label": "Power",
          "type": "boolean",
          "path": "on"
        },
        {
          "id": "bri",
          "label": "Brightness",
          "type": "number",
          "path": "bri"
        }
      ],
      "commandStyle": "json"
    },
