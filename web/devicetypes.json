            "dry",
            "fan_only"
          ]
        },
        {
          "id": "temp",
          "label": "Temperature",
          "type": "number",
          "unit": "°C"
        }
      ],
      "commandStyle": "json"
    },
    "wled": {
      "label": "WLED lighting controller",
